# 本地 Ollama 实验配置（qwen3.5-4b:q4 @ localhost:8000）
# 参考：本目录 env.example（实验专属模板）与仓库根 .env.example（通用模板）。
# 注意：本实验的 config.py 只读 MOONSHOT_API_KEY / KIMI_BASE_URL / SEARCH_TIMEOUT，
# 不读 OLLAMA_BASE_URL —— 端点复用 KIMI_BASE_URL 变量。

# Ollama 的 OpenAI 兼容端点（实测本机服务运行在 8000 端口）
KIMI_BASE_URL=http://localhost:8000/v1
# 占位 key：OpenAI SDK 要求非空，Ollama 不校验内容
MOONSHOT_API_KEY=ollama
# 本地模型名：main.py 用 --model 传入；quickstart.py 读此变量
OLLAMA_MODEL=qwen3.5-4b:q4

# 搜索后端：mock=内置固定样本结果（不联网），验证 ReAct 循环链路
# 接入真实搜索时改为 formula 并换回 Moonshot 端点，或自行扩展搜索实现
SEARCH_BACKEND=mock

# 输出预算：4b/q4 模型配合受限 num_ctx，32k 默认值只会挤占输入空间
MAX_TOKENS=2048

# 单次请求超时（秒）；本地 4b 模型推理快，180s 默认值充裕，无需调整
# SEARCH_TIMEOUT=180