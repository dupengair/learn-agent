# Configuration for Tool Calling Demo
# Copy this file to .env and customize as needed

# Model Configuration (for vLLM)
# MODEL_NAME is the API-facing served model name; MODEL_PATH points to local weights
MODEL_NAME=qwen3-0.6b
# Optional: Path to local model (if you've downloaded it)
MODEL_PATH=/home/dupengair/shared/LLM/Fine-tuning/model/Qwen3-0.6B

# vLLM Server Configuration (if using GPU)
VLLM_HOST=localhost
VLLM_PORT=8000

# Logging
LOG_LEVEL=INFO
