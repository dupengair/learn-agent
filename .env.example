API_KEY="EMPTY"
MODEL_PATH="/home/dupengair/shared/LLM/Fine-tuning/"

# 当前推理后端: ollama / vllm（切换后端只改这一行，脚本零改动，由 llm_config.py 读取）
BACKEND="ollama"

# 两后端共用 8000 端口（Ollama 经 export OLLAMA_HOST=127.0.0.1:8000 启动）
BASE_URL="http://localhost:8000/v1"

# 各后端的模型名（MODEL_OLLAMA 是 ollama list 里注册的 tag）
MODEL_OLLAMA="qwen3.5-4b:q4"
MODEL_VLLM="qwen3-0.6b"
